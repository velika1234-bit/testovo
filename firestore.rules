rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function profileDoc(userId) {
      return /databases/$(database)/documents/artifacts/videoquiz-ultimate-live/users/$(userId)/settings/profile;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.uid == 'uNdGTBsgatZX4uOPTZqKG9qLJVZ2' ||
        get(profileDoc(request.auth.uid)).data.accessLevel == 'admin'
      );
    }

    // Teacher profile settings (admin can read/update all, user can manage own profile)
    match /artifacts/videoquiz-ultimate-live/users/{userId}/settings/profile {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Teacher-owned private collections
    match /artifacts/videoquiz-ultimate-live/users/{userId}/{subCollection}/{docId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Legacy teacher app scope support
    match /artifacts/videoquiz-ultimate/users/{userId}/{subCollection}/{docId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Public session state for live gameplay (kept permissive for clients to join/respond)
    match /artifacts/videoquiz-ultimate-live/public/data/sessions/{sessionId} {
      allow read, write: if true;
    }

    match /artifacts/videoquiz-ultimate-live/public/data/sessions/{sessionId}/participants/{participantId} {
      allow read, write: if true;
    }

    // Legacy participants collection support
    match /artifacts/videoquiz-ultimate-live/public/data/participants/{participantId} {
      allow read, write: if true;
    }
  }
}
